#!/bin/bash
set -euo pipefail

# Query nvim for buffer info via its RPC server socket.

field=$1; shift
target_pane=${1:-$TMUX_PANE}

# Find the nvim server socket for the target pane's process
pane_pid=$(tmux display-message -p -t "${target_pane}" '#{pane_pid}')

# Look for nvim listen address: check child processes of the pane shell
socket=""
for pid in $(pgrep -P "$pane_pid" nvim 2>/dev/null); do
    # nvim sets NVIM_LISTEN_ADDRESS or uses --listen; check /proc for socket
    s=$(grep -z '^NVIM' "/proc/$pid/environ" 2>/dev/null | tr '\0' '\n' | grep NVIM_LISTEN_ADDRESS | cut -d= -f2- || true)
    if [ -n "$s" ] && [ -S "$s" ]; then
        socket="$s"
        break
    fi
    # Try XDG_RUNTIME_DIR default socket path
    s="/run/user/$(id -u)/nvim.${pid}.0"
    if [ -S "$s" ]; then
        socket="$s"
        break
    fi
done

if [ -z "$socket" ]; then
    echo "ERROR: could not find nvim server socket for pane $target_pane" >&2
    exit 1
fi

case "$field" in
    file)
        nvim --server "$socket" --remote-expr 'expand("%:p")'
        ;;
    line)
        nvim --server "$socket" --remote-expr 'line(".")'
        ;;
    column)
        nvim --server "$socket" --remote-expr 'col(".")'
        ;;
    *)
        echo "ERROR: unknown field: $field" >&2
        exit 1
        ;;
esac
