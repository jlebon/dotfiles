#!/bin/bash
set -euo pipefail
shopt -s inherit_errexit

# Send a query to an opencode/pi instance running in the same tmux window.
#
# Modes based on how it's called:
#   tmux-xagent: send file/line context, switch focus (for editor hotkey)
#   xch: send file/line context + arguments, press Enter
#   xc:  send just the arguments, press Enter (no file/line prefix)
#
# File/line context is provided via --file/--line arguments (required for
# tmux-xagent and xch modes).

export HOST_SPAWN_QUIET=1

mode=$(basename "$0")

# Parse options
opt_file=""
opt_line=""
opt_pane=""
opt_type=""
remaining_args=()
while [ $# -gt 0 ]; do
    case "$1" in
        --file) opt_file="$2"; shift 2 ;;
        --line) opt_line="$2"; shift 2 ;;
        --pane) opt_pane="$2"; shift 2 ;;
        --type) opt_type="$2"; shift 2 ;;
        *) remaining_args+=("$1"); shift ;;
    esac
done
set -- "${remaining_args[@]+"${remaining_args[@]}"}"

if [ -n "$opt_pane" ] && [ -n "$opt_type" ]; then
    target_pane="$opt_pane"
    container_type="$opt_type"
else
    # Discover agents in the current tmux window; pick the first one
    first_match=$(tmux-xagent-list | head -n1)
    if [ -z "$first_match" ]; then
        echo "ERROR: No AI assistant instance found" >&2
        exit 1
    fi
    IFS=: read -r target_pane container_type _ <<< "$first_match"
fi

# Expand pane if it's minimized (1 row)
pane_height=$(tmux display-message -p -t "$target_pane" '#{pane_height}')
if [ "$pane_height" -eq 1 ]; then
    tmux resize-pane -t "$target_pane" -y 999
fi

# Send to the agent pane based on mode
clear_input() {
    if [ "$container_type" = "opencode" ]; then
        # OpenCode: Shift-Home to select all, then Backspace to delete
        tmux send-keys -t "$target_pane" S-Home
        tmux send-keys -t "$target_pane" BSpace
    else
        # Pi: Home + Ctrl-K loop
        for _ in {1..10}; do
            tmux send-keys -t "$target_pane" Home
            sleep 0.01
            tmux send-keys -t "$target_pane" C-k
        done
    fi
}

case "$mode" in
    xc)
        clear_input
        tmux send-keys -t "$target_pane" "$*"
        tmux send-keys -t "$target_pane" Enter
        ;;
    xch)
        if [ -z "${opt_file}" ] || [ -z "${opt_line}" ]; then
            echo "ERROR: --file and --line are required" >&2
            exit 1
        fi
        clear_input
        tmux send-keys -t "$target_pane" "in file ${opt_file} at line ${opt_line}: $*"
        tmux send-keys -t "$target_pane" Enter
        ;;
    *)
        # tmux-xagent: focus mode for editor hotkey
        if [ -z "${opt_file}" ] || [ -z "${opt_line}" ]; then
            echo "ERROR: --file and --line are required" >&2
            exit 1
        fi
        clear_input
        tmux send-keys -t "$target_pane" "in file ${opt_file} at line ${opt_line} (reread the file carefully, it may have changed): "
        tmux select-pane -t "$target_pane"
        ;;
esac
