#!/bin/bash
set -euo pipefail
shopt -s inherit_errexit

# Detect invocation mode based on how we were called
case "$(basename "$0")" in
    xoc) mode=opencode ;;
    xpi) mode=pi ;;
    *) echo "ERROR: unknown mode: $(basename "$0")" >&2; exit 1 ;;
esac

# Run opencode/pi in an unprivileged container using the same container image in
# which we're running. The primary use case is a pet container image you've
# customized with various dev tools, and you want OpenCode/Pi to be able to use
# those tools as well. Note this runs `podman`; in my case, `podman` is actually
# ~/.local/mybin/podman and just proxies to the real host podman via
# `host-spawn`. That wrapper is available in my dotfiles repo as well, but one
# can probably just change the podman call at the bottom to `flatpak-spawn
# --host`

if [ ! -e "/run/.containerenv" ]; then
    echo "ERROR: Must be run from pet container" >&2
    exit 1
fi

# Parse our own arguments
add_dirs=()
add_repos=()
extra_volumes=()
tool_args=()
git_mount_mode=ro
run_bash=false
custom_image=""
mount_oci_auth=false
mount_kube=false
mount_host_ca_certs=false
host_cgroupns=false
forward_anki=false
net_mode=""
clean_volumes=false
force_update=false
allow_no_git=false
usage() {
    cat <<EOF
Usage: $(basename "$0") [OPTIONS] [-- ARGS...]

Run opencode/pi in an unprivileged container.

Options:
  -h            Show this help message
  --git-rw      Mount .git directory read-write (default: read-only)
  --bash        Run bash instead of opencode/pi
  --image IMG   Use a custom container image
  --oci-auth    Mount Docker config (~/.docker/config.json)
  --kube        Mount Kubernetes config (~/.kube/config)
  --host-ca-certs Mount host CA certificates (/etc/pki/ca-trust)
  --host-cgroupns Use host cgroup namespace
  --anki        Forward AnkiConnect (localhost:8765) via Unix socket
  --net MODE    Set network mode (passed to podman --net)
  --add-dir DIR Add a directory to the container (default: read-only; append :rw/:ro)
  --add-repo R  Add a repo (comma-separated) from ~/Code
  -v VOLUME     Add an extra volume mount
  --clean       Remove existing named volumes before starting
  --allow-no-git Allow starting in a directory that is not a git repo
  --update      Force an update (opencode/pi modes)
  --web         Run in web server mode (opencode only); serves UI on LAN
  --port PORT   Port for web server (default: 4096; implies --web)
  --            Stop parsing options; remaining args passed to tool
EOF
}

while [ $# -gt 0 ]; do
    case "$1" in
        -h)
            usage
            exit 0
            ;;
        --)
            shift
            tool_args+=("$@")
            break
            ;;
        --git-rw)
            git_mount_mode=rw
            shift
            ;;
        --bash)
            run_bash=true
            shift
            ;;
        --image)
            if [ -z "${2:-}" ]; then
                echo "ERROR: --image requires an image argument" >&2
                exit 1
            fi
            custom_image="$2"
            shift 2
            ;;
        --oci-auth)
            mount_oci_auth=true
            shift
            ;;
        --kube)
            mount_kube=true
            shift
            ;;
        --host-ca-certs)
            mount_host_ca_certs=true
            shift
            ;;
        --anki)
            forward_anki=true
            shift
            ;;
        --host-cgroupns)
            host_cgroupns=true
            shift
            ;;
        --net)
            if [ -z "${2:-}" ]; then
                echo "ERROR: --net requires a mode argument" >&2
                exit 1
            fi
            net_mode="$2"
            shift 2
            ;;
        --allow-no-git)
            allow_no_git=true
            shift
            ;;
        --clean)
            clean_volumes=true
            shift
            ;;
        --update)
            force_update=true
            shift
            ;;
        --add-dir)
            if [ -z "${2:-}" ]; then
                echo "ERROR: --add-dir requires a directory argument" >&2
                exit 1
            fi
            add_dirs+=("$2")
            shift 2
            ;;
        --add-repo)
            if [ -z "${2:-}" ]; then
                echo "ERROR: --add-repo requires a repo name argument" >&2
                exit 1
            fi
            IFS=',' read -ra repos <<< "$2"
            add_repos+=("${repos[@]}")
            shift 2
            ;;
        -v)
            if [ -z "${2:-}" ]; then
                echo "ERROR: -v requires a volume argument" >&2
                exit 1
            fi
            extra_volumes+=("$2")
            shift 2
            ;;
        *)
            tool_args+=("$1")
            shift
            ;;
    esac
done

if [ ! -e .git ] && [ -z "${SAFE_PWD:-}" ] && [ "${allow_no_git}" != "true" ]; then
    echo "ERROR: not in a git repo" >&2
    exit 1
fi

cd "$(realpath "${PWD}")"

# Generate volume prefix from working directory for named volumes
vol_hash=$(echo "$PWD" | md5sum | cut -c1-8)
vol_slug=$(basename "$PWD" | tr -cs 'a-zA-Z0-9' '-' | sed 's/-$//')
vol_prefix="xagent-${vol_hash}-${vol_slug}"

# Clean up existing volumes if requested
if [ "${clean_volumes}" = "true" ]; then
    podman volume rm -f "${vol_prefix}-containers" "${vol_prefix}-var-tmp" "${vol_prefix}-tmp" 2>/dev/null || true
fi

if [ -n "${custom_image}" ]; then
    imageid="${custom_image}"
else
    imageid=$(source /run/.containerenv; echo "${imageid}")
fi

# Use -t only when stdin is a TTY; omit it when piped (e.g. ralph loop)
podman_args=(
    run --rm -i
)
if [ -t 0 ]; then
    podman_args+=(-t --detach-keys "")
fi
podman_args+=(
    --privileged
    --init
    -v "${vol_prefix}-containers:/var/lib/containers"
    -v "${vol_prefix}-var-tmp:/var/tmp"
    -v "${vol_prefix}-tmp:/tmp"
    --label "${mode}=1"
    --env EDITOR=nvim
    --env GIT_SEQUENCE_EDITOR=true
    --env TERM="${TERM}"
    --env PATH="${PATH}"
    --env HOME="${HOME}"
    --tmpfs "${HOME}"
    --tz local
    -v "${HOME}/.cache"
    -v "${HOME}/.cargo:${HOME}/.cargo"
    -v "${HOME}/.cargo/bin:${HOME}/.cargo/bin:ro"
    -v "${HOME}/.rustup:${HOME}/.rustup:ro"
    -v "${HOME}"/Code/go/bin:"${HOME}"/Code/go/bin:ro
    -v "${HOME}"/Code/nodejs:"${HOME}"/Code/nodejs:ro
    -v "${HOME}"/.local/mybin:"${HOME}"/.local/mybin:ro
    -v "${HOME}"/.config/gcloud:"${HOME}"/.config/gcloud:ro
    -v "${HOME}"/.config/nvim:"${HOME}"/.config/nvim:ro
    -v "${HOME}"/.agents:"${HOME}"/.agents:ro
    -v "${PWD}":"${PWD}"
    -w "${PWD}"
)

# Mode-specific mounts
if [ "${mode}" = "pi" ]; then
    podman_args+=(
        -v "${HOME}"/.pi:"${HOME}"/.pi
    )
else
    podman_args+=(
        -v "${HOME}"/.opencode:"${HOME}"/.opencode
        -v "${HOME}"/.config/opencode:"${HOME}"/.config/opencode
        -v "${HOME}"/.local/share/opencode:"${HOME}"/.local/share/opencode
        -v "${HOME}"/.local/state/opencode:"${HOME}"/.local/state/opencode
        -v "${HOME}"/.cache/opencode:"${HOME}"/.cache/opencode
    )
    # --publish 192.168.2.1:8080:8080
fi

if [ -e .git ]; then
    primary_worktree=$(git worktree list | head -n1 | cut -f1 -d' ')
    if [ -f .git ]; then
        podman_args+=(-v "${primary_worktree}:${primary_worktree}:${git_mount_mode}")
    fi
    podman_args+=(-v "${PWD}"/.git:"${PWD}"/.git:"${git_mount_mode}")
    if [ "${git_mount_mode}" = "rw" ]; then
        podman_args+=(-v "${primary_worktree}/.git/config:${primary_worktree}/.git/config:ro")
        podman_args+=(-v "${HOME}/.gitconfig:${HOME}/.gitconfig:ro")
        podman_args+=(-v "${HOME}/.ssh/id_ed25519.git-sign:${HOME}/.ssh/id_ed25519.git-sign:ro")
        podman_args+=(-v "${HOME}/.ssh/id_ed25519.git-sign.pub:${HOME}/.ssh/id_ed25519.git-sign.pub:ro")
        # Create a read-only backup of .git for recovery
        rm -rf "${primary_worktree}"/.git/bak
        cp --reflink=always -a "${primary_worktree}/.git" \
            "${primary_worktree}/.git-bak-tmp"
        mv "${primary_worktree}/.git-bak-tmp" "${primary_worktree}/.git/bak"
        podman_args+=(-v "${primary_worktree}/.git/bak:${primary_worktree}/.git/bak:ro")
    fi
fi

resolved_dirs=()
resolved_dir_modes=()
for dir in "${add_dirs[@]}"; do
    if [[ "${dir}" == *:rw ]]; then
        dir_mode=rw
        dir=${dir%:rw}
    elif [[ "${dir}" == *:ro ]]; then
        dir_mode=ro
        dir=${dir%:ro}
    else
        dir_mode=ro
    fi
    dir=$(realpath "${dir}")
    resolved_dirs+=("${dir}")
    resolved_dir_modes+=("${dir_mode}")
    podman_args+=(-v "${dir}:${dir}:${dir_mode}")
done

resolved_repos=()
for repo in "${add_repos[@]}"; do
    if [[ "${repo}" == *:rw ]]; then
        repo_mode=rw
        repo=${repo%:rw}
    elif [[ "${repo}" == *:ro ]]; then
        repo_mode=ro
        repo=${repo%:ro}
    else
        repo_mode=ro
    fi
    repo_path=$(realpath "$(codeswitch ~/Code "${repo}")")
    resolved_repos+=("${repo_path}")
    podman_args+=(-v "${repo_path}:${repo_path}:${repo_mode}")
    if [ "${repo_mode}" = "rw" ] && [ -d "${repo_path}/.git" ]; then
        podman_args+=(-v "${repo_path}/.git/config:${repo_path}/.git/config:ro")
    fi
done

for vol in "${extra_volumes[@]}"; do
    podman_args+=(-v "${vol}")
done

# secret-tool can sometimes flake; retry a few times
secret-tool-retry() {
    local retries=3
    for ((i=1; i<=retries; i++)); do
        if result=$(secret-tool "$@") && [ -n "${result}" ]; then
            echo "${result}"
            return 0
        fi
        sleep 1
    done
    echo "ERROR: secret-tool $* failed after ${retries} retries" >&2
    return 1
}

GITHUB_TOKEN=$(secret-tool-retry lookup github-cli-read-only token)
export GITHUB_TOKEN
podman_args+=(--env GITHUB_TOKEN)

GITLAB_TOKEN=$(secret-tool-retry lookup gitlab-cli-read-only token)
export GITLAB_TOKEN
podman_args+=(--env GITLAB_TOKEN)

if [ "${mount_oci_auth}" = "true" ]; then
    podman_args+=(-v "${HOME}/.docker/config.json:${HOME}/.docker/config.json:ro")
fi

if [ "${mount_kube}" = "true" ]; then
    podman_args+=(-v "${HOME}/.kube/config:${HOME}/.kube/config:ro")
fi

if [ "${mount_host_ca_certs}" = "true" ]; then
    podman_args+=(-v /etc/pki/ca-trust:/etc/pki/ca-trust:ro)
fi

podman_args+=(-v "/srv/imgs:/run/host/srv/imgs:rw")

if [ "${host_cgroupns}" = "true" ]; then
    podman_args+=(--cgroupns=host)
fi

if [ -n "${net_mode}" ]; then
    podman_args+=(--net="${net_mode}")
fi

# add tmux info if we're running in tmux
if [ -n "${TMUX_PANE:-}" ]; then
    podman_args+=(--label TMUX_PANE="${TMUX_PANE}")
    podman_args+=(--label TMUX_WINDOW="$(tmux display-message -p '#{window_id}')")
fi

# start anki-connect forwarder: bridges localhost:8765 to a unix socket
anki_socat_pid=""
if [ "${forward_anki}" = "true" ]; then
    anki_sock_dir=$(mktemp -d)
    anki_sock="${anki_sock_dir}/anki-connect.sock"
    socat UNIX-LISTEN:"${anki_sock}",fork TCP:127.0.0.1:8765 &
    anki_socat_pid=$!
    # give socat a moment to bind
    while [ ! -S "${anki_sock}" ]; do sleep 0.1; done
    podman_args+=(-v "${anki_sock_dir}:${anki_sock_dir}")
    podman_args+=(--env ANKI_CONNECT_SOCKET="${anki_sock}")
fi

# start hostexec so the agent can request host command execution
hostd_pid=""
if [ -n "${TMUX_PANE:-}" ]; then
    hostd_sock_file=$(mktemp)
    env -u GITHUB_TOKEN -u GITLAB_TOKEN setpriv --pdeathsig TERM hostexec serve --write-socket-path-to "${hostd_sock_file}" &
    hostd_pid=$!
    # wait for the socket path to be written
    while [ ! -s "${hostd_sock_file}" ]; do sleep 0.1; done
    hostd_sock=$(cat "${hostd_sock_file}")
    hostd_sock_dir=$(dirname "${hostd_sock}")
    podman_args+=(-v "${hostd_sock_dir}:${hostd_sock_dir}")
    podman_args+=(-v "$(command -v hostexec):/usr/local/bin/hostexec:ro")
    podman_args+=(--env HOSTEXEC_SOCKET="${hostd_sock}")
fi

# env vars
# shellcheck disable=SC1090
source ~/"Documents/Red Hat/claude-env.sh"

# Build runtime context instructions
context="# Runtime Context\n"
if [ "${git_mount_mode}" = "rw" ]; then
    context+="- You have read-write access to the git repo.\n"
else
    context+="- You have read-only access to the git repo. The .git directory is mounted read-only.\n"
fi
if [ ${#resolved_repos[@]} -gt 0 ]; then
    context+="- You have access to the following additional git repos:\n"
    for path in "${resolved_repos[@]}"; do
        context+="  - ${path}\n"
    done
fi
if [ ${#resolved_dirs[@]} -gt 0 ]; then
    context+="- You have access to the following additional directories:\n"
    for i in "${!resolved_dirs[@]}"; do
        context+="  - ${resolved_dirs[$i]} (${resolved_dir_modes[$i]})\n"
    done
fi
context_file=$(mktemp -p "${XDG_RUNTIME_DIR}")
echo -e "${context}" > "${context_file}"

if [ "${mode}" = "pi" ]; then
    podman_args+=(
        --env GOOGLE_CLOUD_PROJECT
        --env GOOGLE_CLOUD_LOCATION
        --env PI_OFFLINE=1
        --env PATH="${HOME}/.pi:${PATH}"
        -v "${context_file}:/run/pi-context.md:ro"
    )
    HOST_SPAWN_ENV=GOOGLE_CLOUD_PROJECT,GOOGLE_CLOUD_LOCATION
else
    podman_args+=(
        --env VERTEX_REGION
        --env GOOGLE_CLOUD_PROJECT
        --env OPENCODE_PERMISSION='{"external_directory":"allow"}'
        --env OPENCODE_EXPERIMENTAL_PLAN_MODE=true
        -v "${context_file}:/run/opencode-context.md:ro"
        --env OPENCODE_CONFIG_CONTENT='{"instructions":["/run/opencode-context.md"]}'
    )
    HOST_SPAWN_ENV=VERTEX_REGION,GOOGLE_CLOUD_PROJECT,OPENCODE_PERMISSION
    if [ -n "${OPENCODE_CLIENT:-}" ]; then
        podman_args+=(--env OPENCODE_CLIENT)
        HOST_SPAWN_ENV="${HOST_SPAWN_ENV},OPENCODE_CLIENT"
    fi
fi

HOST_SPAWN_ENV="${HOST_SPAWN_ENV},GITHUB_TOKEN,GITLAB_TOKEN"

# cargo env vars - pass through all CARGO_* variables
while IFS='=' read -r var _; do
    if [[ "$var" == CARGO_* ]]; then
        podman_args+=(--env "$var")
        HOST_SPAWN_ENV="${HOST_SPAWN_ENV},${var}"
    fi
done < <(env)

# C/C++ compiler env vars
for var in CC CFLAGS CXXFLAGS; do
    if [ -n "${!var:-}" ]; then
        podman_args+=(--env "$var")
        HOST_SPAWN_ENV="${HOST_SPAWN_ENV},${var}"
    fi
done

export HOST_SPAWN_ENV

# clean up hostexec on exit
cleanup() {
    if [ -n "${anki_socat_pid}" ]; then
        kill "${anki_socat_pid}" 2>/dev/null
        wait "${anki_socat_pid}" 2>/dev/null
        rm -rf "${anki_sock_dir:-}"
    fi
    if [ -n "${hostd_pid}" ]; then
        HOSTEXEC_SOCKET="${hostd_sock}" hostexec notify session-exit 2>/dev/null || true
        kill "${hostd_pid}" 2>/dev/null
        wait "${hostd_pid}" 2>/dev/null
        rm -f "${hostd_sock_file}"
    fi
    rm -f "${context_file:-}"
}
trap cleanup EXIT

# and the actual image and command
podman_args+=("${imageid}")
# Start podman API socket inside the container. Without systemd, there's no
# socket activation, so tools using the podman Go bindings (e.g. bink) need the
# service running. The --init flag (catatonit) keeps it alive after exec.
podman_svc='mkdir -p /run/podman; podman system service --time=0 unix:///run/podman/podman.sock &>/dev/null &'

if [ "${run_bash}" = "true" ]; then
    podman "${podman_args[@]}" bash -c "${podman_svc}
    exec bash"
elif [ "${mode}" = "pi" ]; then
    podman "${podman_args[@]}" bash -c '
'"${podman_svc}"'
force_update="$1"; shift
bin="$HOME/.pi/pi"
if [ -f "$bin" ]; then
    current=$("$bin" -v 2>/dev/null || echo "")
    latest=$(curl -sL https://api.github.com/repos/badlogic/pi-mono/releases/latest | jq -r ".tag_name" | sed "s/^v//")
    if [ -n "$latest" ] && [ -n "$current" ] && { [ "$force_update" = "true" ] || [ "$current" != "$latest" ]; }; then
        echo "Updating pi from $current to $latest..."
        curl -sL "https://github.com/badlogic/pi-mono/releases/download/v${latest}/pi-linux-x64.tar.gz" \
            | tar xz -C "$HOME/.pi" --strip-components=1 --no-same-owner
    fi
fi
exec "$bin" --append-system-prompt /run/pi-context.md "$@"' -- "${force_update}" "${tool_args[@]}"
else
    podman "${podman_args[@]}" bash -c '
'"${podman_svc}"'
force_update="$1"; shift
bin="$HOME/.opencode/bin/opencode"
if [ -f "$bin" ]; then
    mtime=$(stat -c %Y "$bin" 2>/dev/null || echo 0)
    now=$(date +%s)
    if [ "$force_update" = "true" ] || [ $((now - mtime)) -gt 86400 ]; then
        "$bin" upgrade && touch "$bin"
    fi
fi
exec "$bin" "$@"' -- "${force_update}" "${tool_args[@]}"
fi
